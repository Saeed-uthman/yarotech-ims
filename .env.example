# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Django local development defaults
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=local-development-only-key-change-before-production-2026
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_TIME_ZONE=Africa/Lagos
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:5173

# Keep SQLite for local development. Change DB_ENGINE to postgresql only when
# the PostgreSQL server and database below are ready.
DB_ENGINE=sqlite
# SQLITE_PATH can be set to an absolute path; when omitted it uses
# alamaan_backend/db.sqlite3.

# Local backup automation. A relative path is resolved from the repository
# root. For real use, point this at a second disk or a synced encrypted folder.
PHARMACY_BACKUP_DIR=backups
PHARMACY_BACKUP_RETENTION_DAYS=30
PHARMACY_BACKUP_MIN_INTERVAL_HOURS=12

# PostgreSQL production/concurrency-test settings
DB_NAME=alamaan_pharmacy
DB_USER=alamaan_user
DB_PASSWORD=replace-with-a-secret-password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=prefer
DB_CONN_MAX_AGE=60

# JWT and authentication throttling
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
AUTH_LOGIN_RATE=10/min
AUTH_REGISTER_RATE=5/min
AUTH_REFRESH_RATE=30/min

# Production HTTPS settings. Enable only behind a trusted HTTPS reverse proxy.
DJANGO_TRUST_PROXY_HEADERS=False
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False

# Operations
DJANGO_LOG_LEVEL=INFO
DJANGO_MAX_REQUEST_BYTES=5242880
DJANGO_MAX_UPLOAD_BYTES=5242880
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0

# Optional legacy app-host fields
GEMINI_API_KEY=
APP_URL=http://localhost:3000
