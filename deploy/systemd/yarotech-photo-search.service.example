[Unit]
Description=Yarotech POS local photo matching
After=network.target

[Service]
# Replace user/group/environment path with the existing POS API settings.
Type=simple
User=REPLACE_WITH_API_USER
Group=REPLACE_WITH_API_GROUP
WorkingDirectory=/var/www/yarotech-ims/alamaan_backend
EnvironmentFile=/etc/yarotech-pos/photo-search.env
Environment=OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
ExecStart=/var/www/yarotech-ims/.venv-photo/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8025 --workers 1 --worker-class gthread --threads 2 --timeout 45 --access-logfile - --error-logfile -
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
CPUQuota=100%
MemoryMax=1G
TasksMax=64
Nice=5
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/yarotech-ims/alamaan_backend/logs

[Install]
WantedBy=multi-user.target
